                <mxCell id="abt_right" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#A7B2C4;" value="I’m Raghav Sharma, a Senior Data Scientist at Walmart. My work spans retail inventory systems, financial forecasting, healthcare modeling, and agentic AI.&#xa;&#xa;I enjoy turning research ideas into maintainable systems: from transformer models and fairness algorithms to ML pipelines with monitoring and automated retraining.&#xa;&#xa;&lt;b&gt;&lt;font color=&quot;#EEF2F8&quot;&gt;Follow my work on GitHub ↗&lt;/font&gt;&lt;/b&gt;" vertex="1">
                    <mxGeometry height="140" width="560" x="720" y="2980" as="geometry"/>
                </mxCell>
