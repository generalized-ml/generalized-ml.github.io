                <mxCell id="exp_job1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#BCF587;" value="OCT 2025 — PRESENT&#xa;&lt;b&gt;&lt;font color=&quot;#EEF2F8&quot; size=&quot;4&quot;&gt;Walmart&lt;/font&gt;&lt;/b&gt;&#xa;Senior Data Scientist" vertex="1">
                    <mxGeometry height="80" width="240" x="160" y="2120" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job1_desc" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#A7B2C4;" value="• Designed and deployed an inventory ML pipeline across 5,200 US and Canadian stores.&#xa;• Improved recommendations for a waste app, contributing to a 35% increase in adoption.&#xa;• Refactored codebase for multiple markets, reducing cloud costs by 21%." vertex="1">
                    <mxGeometry height="80" width="840" x="440" y="2120" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job2" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#BCF587;" value="OCT 2023 — SEP 2025&#xa;&lt;b&gt;&lt;font color=&quot;#EEF2F8&quot; size=&quot;4&quot;&gt;Mastercard&lt;/font&gt;&lt;/b&gt;&#xa;Senior Data Scientist" vertex="1">
                    <mxGeometry height="80" width="240" x="160" y="2240" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job2_desc" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#A7B2C4;" value="• Led revenue forecasting team, translating stakeholder requirements into solutions.&#xa;• Built an LLM-powered agentic chatbot for tabular data to support forecast reasoning.&#xa;• Reduced forecasting execution time from 12 days to 4 hours; 98.5% forecast accuracy.&#xa;• Built anomaly detection and model accuracy monitoring for deployed system." vertex="1">
                    <mxGeometry height="90" width="840" x="440" y="2240" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#BCF587;" value="FEB 2022 — SEP 2023&#xa;&lt;b&gt;&lt;font color=&quot;#EEF2F8&quot; size=&quot;4&quot;&gt;Mastercard&lt;/font&gt;&lt;/b&gt;&#xa;Data Scientist 2" vertex="1">
                    <mxGeometry height="80" width="240" x="160" y="2380" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job3_desc" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#A7B2C4;" value="• Improved weekly revenue forecast accuracy by 13% with Finance &amp; Data Engineering.&#xa;• Optimized codebase, reducing execution time by 37% and code length by 21%.&#xa;• Developed a bias mitigation algorithm to improve fairness in deployed models." vertex="1">
                    <mxGeometry height="80" width="840" x="440" y="2380" as="geometry"/>
                </mxCell>
                <mxCell id="exp_job4" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#BCF587;" value="AUG 2020 — JAN 2022&#xa;&lt;b&gt;&lt;font color=&quot;#EEF2F8&quot; size=&quot;4&quot;&gt;ZS&lt;/font&gt;&lt;/b&gt;&#xa;Data Science Associate" vertex="1">
